{
  "plugins": ["@hubspot/prettier-plugin-hubl"],
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "hubl",
        "printWidth": 120,
        "tabWidth": 2,
        "singleQuote": true,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "semi": true,
        "arrowParens": "always",
        "htmlWhitespaceSensitivity": "ignore",
        "endOfLine": "lf"
      }
    },
    {
      "files": "*.css",
      "options": {
        "parser": "css",
        "printWidth": 120,
        "tabWidth": 2,
        "singleQuote": true,
        "trailingComma": "es5"
      }
    },
    {
      "files": "*.js",
      "options": {
        "parser": "babel",
        "printWidth": 100,
        "tabWidth": 2,
        "singleQuote": true,
        "trailingComma": "es5",
        "semi": true,
        "arrowParens": "always",
        "bracketSpacing": true,
        "endOfLine": "lf"
      }
    }
  ],
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "ignore",
  "proseWrap": "always",
  "quoteProps": "as-needed"
}
